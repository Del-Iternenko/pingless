{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLag Setup",
  "version": "0.1.0",
  "identifier": "dev.openlag.setup",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Установка OpenLag",
        "width": 920,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#07090f",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"] }
}
